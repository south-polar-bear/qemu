# 使用 Ubuntu 24.04 作为基础镜像
FROM ubuntu:24.04

# 设置环境变量，避免安装时出现交互界面
ENV DEBIAN_FRONTEND=noninteractive

# 更新软件包列表并安装基本工具
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    vim \
    git \
    python3 \
    python3-pip \
    build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录
WORKDIR /app

# 复制应用文件到容器中
COPY . /app

# 如果是 Python 应用，可以安装依赖
RUN pip3 install --no-cache-dir -r requirements.txt 2>/dev/null || true

# 暴露端口（如果需要）
EXPOSE 8080

# 设置默认命令
CMD ["/bin/bash"]
